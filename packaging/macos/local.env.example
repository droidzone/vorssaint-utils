# Local Box settings for ./compile.sh release and ./compile.sh release-install.
# Copy to local.env. That file is gitignored.

# The folder id is the number in the Box folder URL:
# https://app.box.com/folder/432984409767
GEEKPLAY_BOX_FOLDER_ID=432984409767

# A developer token works until it expires (about an hour).
GEEKPLAY_BOX_ACCESS_TOKEN=

# For unattended builds, use an OAuth refresh token or an enterprise app.
# When all three are set, the upload refreshes the access token and saves it here.
GEEKPLAY_BOX_CLIENT_ID=n3igy1jy1dd3h6rk0oe4t83swzpjz3hs
# GEEKPLAY_BOX_CLIENT_SECRET=8qHOcg6yEJ4MDmJmsJ8XF9mMWrT1wyzk
# GEEKPLAY_BOX_REFRESH_TOKEN=dNXIu3GfYSOnKRKpwW2HLK5x3KPnOOch8sdspBv8PHjwrk6vWILOj0exnp43fYny

# Enterprise client-credentials app. Used instead of the tokens above when set.
# GEEKPLAY_BOX_ENTERPRISE_ID=
